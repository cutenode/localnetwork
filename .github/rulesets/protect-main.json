{
	"name": "Protect Main",
	"target": "branch",
	"enforcement": "active",
	"conditions": {
		"ref_name": {
			"exclude": [],
			"include": ["~DEFAULT_BRANCH"]
		}
	},
	"rules": [
		{
			"type": "deletion"
		},
		{
			"type": "non_fast_forward"
		},
		{
			"type": "code_scanning",
			"parameters": {
				"code_scanning_tools": [
					{
						"tool": "CodeQL",
						"security_alerts_threshold": "high_or_higher",
						"alerts_threshold": "errors"
					}
				]
			}
		},
		{
			"type": "required_status_checks",
			"parameters": {
				"strict_required_status_checks_policy": false,
				"do_not_enforce_on_create": false,
				"required_status_checks": [
					{
						"context": "Web CI passed"
					},
					{
						"context": "locallibrary CI passed"
					},
					{
						"context": "localtoolbox CI passed"
					},
					{
						"context": "Mix report passed"
					},
					{
						"context": "npm advisories passed"
					},
					{
						"context": "Workflow lint passed"
					},
					{
						"context": "Repo checks passed"
					},
					{
						"context": "atstore CI passed"
					}
				]
			}
		}
	],
	"bypass_actors": []
}
