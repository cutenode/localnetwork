	"verify:rust": [
		"cargo fmt --all --check",
		"cargo fmt --manifest-path fuzz/Cargo.toml --check",
		"cargo shear",
		"cargo clippy -p locallibrary-core -p locallibrary --no-default-features --all-targets --locked -- -D warnings",
		"cargo clippy -p loclib-interop --no-default-features --all-targets --locked -- -D warnings",
		"cargo nextest run -p locallibrary --no-default-features --locked -E \"test(commands_come_with_the_features_built_in)\"",
		"cargo clippy --workspace --all-targets --locked -- -D warnings",
		"cargo clippy --manifest-path fuzz/Cargo.toml --all-targets --locked -- -D warnings",
		"pnpm exec lefthook run pre-push --job \"clippy for Windows\" --force",
		"cargo test --doc --workspace --locked",
		"cargo doc-strict",
		"node tools/crates-io/cli.ts package",
		"node tools/verify/release-cli.ts",
		"cargo nextest run --workspace --locked"
	],
	"verify:repo": [
		"pnpm policy",
		"pnpm exec ast-grep test --skip-snapshot-tests",
		"pnpm exec ast-grep scan",
		"pnpm test:tools",
		"npm ci --prefix apps/locallibrary/bombadil",
		"npm run typecheck --prefix apps/locallibrary/bombadil",
		"git ls-files -z \"*.sh\" | xargs -0 shellcheck",
		"typos",
		"taplo fmt --check",
		"pnpm lexicons:goat lint --lint-level error",
		"pnpm lexicons:goat breaking",
		"git ls-files -z \"*.md\" | xargs -0 lychee --offline --include-fragments --no-progress"
