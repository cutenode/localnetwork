{
	"verify": [
		"pnpm lexicons:format --check",
		"pnpm format:tools --check",
		"npm ci --prefix apps/locallibrary/bombadil",
		"pnpm lint:tools",
		"pnpm check:tools",
		"pnpm knip",
		"pnpm -r --no-bail verify"
