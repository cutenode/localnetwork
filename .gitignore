# Cargo's build output for the Rust workspace.
/target
**/*.rs.bk
# Hegel keeps failing examples here to replay them first next time.
.hegel/
# A Swift build cache that tools drop at the root (there's no Swift package here).
/.build/
# cargo-mutants' results (.cargo/mutants.toml).
/mutants.out*
# Stryker's sandboxes for apps/localtoolbox (its stryker.config.mjs says why they're here).
/.stryker-tmp/
node_modules/
# The coverage report from `pnpm test:tools`.
/coverage/
.DS_Store
Thumbs.db
# Local secrets, in any app.
.env
.env.*
!.env.example
