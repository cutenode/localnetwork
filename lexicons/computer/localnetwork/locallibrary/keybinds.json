				},
				"keys": {
					"type": "array",
					"maxLength": 8,
					"description": "In order: for deck.hot-cue, the nth key plays the nth hot cue.",
					"items": { "type": "ref", "ref": "#key" }
				}
			}
		},
		"key": {
			"type": "string",
			"maxLength": 16,
			"description": "A key, named the same on every platform: one character as typed (a, A, %, é; a capital is shift and the letter), one of the knownValues, shift- and one of those names but the f keys (shift-up), or ctrl- and a lowercase letter (ctrl-q). A key a reader can't read is skipped.",
			"knownValues": [
				"space",
				"enter",
				"tab",
				"shift-tab",
				"backspace",
				"delete",
				"insert",
				"home",
				"end",
				"pageup",
				"pagedown",
				"up",
				"down",
				"left",
				"right",
