{
	"lexicon": 1,
	"id": "computer.localnetwork.locallibrary.keybinds",
	"description": "The keys someone set in locallibrary's player, published so they load on any computer where that account signs in, and so others can import them. Written and read by locallibrary.",
	"defs": {
		"main": {
			"type": "record",
			"key": "literal:self",
			"description": "One per account. Holds only the actions whose keys differ from the player's defaults; every other action keeps its default key. A reader ignores an action it doesn't know, so older and newer versions can share a record.",
			"record": {
				"type": "object",
				"required": ["bindings", "updatedAt"],
				"properties": {
					"bindings": {
						"type": "array",
						"maxLength": 512,
						"items": { "type": "ref", "ref": "#binding" }
					},
					"from": {
						"type": "string",
						"format": "did",
						"description": "The account these keys were imported from, for credit."
					},
					"updatedAt": { "type": "string", "format": "datetime" }
				}
			}
		},
		"binding": {
			"type": "object",
			"description": "An action and the keys that do it. An empty list means the action has no key.",
			"required": ["action", "keys"],
			"properties": {
				"action": {
					"type": "string",
					"maxLength": 128,
					"description": "The action's id, which never changes once released. A plugin's command or operation is plugin.<plugin id>.<name>.",
