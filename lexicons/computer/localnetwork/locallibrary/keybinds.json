						"deck.auto-cue",
						"deck.outputs",
						"visuals.visualiser",
						"visuals.waveform-colours",
						"visuals.zoom-out",
						"visuals.zoom-in",
						"visuals.player-mode",
						"visuals.browse",
						"move.up",
						"move.down",
						"move.page-up",
						"move.page-down",
						"move.first",
						"move.last",
						"move.next-pane",
						"move.previous-pane",
						"library.search",
						"library.actions",
						"library.info",
