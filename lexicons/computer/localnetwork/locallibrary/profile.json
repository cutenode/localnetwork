{
  "lexicon": 1,
  "id": "computer.localnetwork.locallibrary.profile",
  "description": "A DJ's public profile: how they play, worked out by locallibrary from the history lists players record during sets, the tracks' rekordbox analysis and the DJ's My Settings.",
  "defs": {
    "main": {
      "type": "record",
      "key": "literal:self",
      "description": "One per account, written by `locallibrary profile publish`. Only the sections the DJ chose are present. Never holds file paths, drive or history-list names, ratings or exact dates. Shares are whole percents (0 to 100) and tempos whole BPM.",
      "record": {
        "type": "object",
        "required": ["version", "generatedAt", "precision", "basis"],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1,
            "description": "The format: 1. A version that changes what a field means gets a new number."
          },
          "generatedAt": { "type": "string", "format": "datetime" },
          "precision": {
            "type": "string",
            "description": "rounded: counts are round numbers the true count is at least, and shares are to 5%. exact: as counted.",
            "knownValues": ["rounded", "exact"]
          },
          "basis": {
            "type": "string",
            "description": "plays: tracks as played in sets (a track in three sets counts three times). collection: no sets were found, so the collection, each track once.",
            "knownValues": ["plays", "collection"]
          },
          "headline": {
            "type": "string",
            "maxLength": 1000,
            "maxGraphemes": 120,
            "description": "One line, written by the DJ or built from the sections present (genres, tempo, how many sets)."
          },
          "tags": {
            "type": "array",
            "maxLength": 20,
            "description": "Traits the numbers support, like \"Mixes in key\". Only traits backed by a section that's present.",
            "items": { "type": "string", "maxLength": 300, "maxGraphemes": 60 }
          },
          "sets": { "type": "ref", "ref": "#sets" },
          "tempo": { "type": "ref", "ref": "#tempo" },
          "arc": { "type": "ref", "ref": "#arc" },
          "mixing": { "type": "ref", "ref": "#mixing" },
          "keys": { "type": "ref", "ref": "#keys" },
          "energy": { "type": "ref", "ref": "#energy" },
          "genres": {
            "type": "array",
            "maxLength": 10,
            "description": "The genres played most, with their share of plays.",
            "items": { "type": "ref", "ref": "#share" }
          },
          "labels": {
            "type": "array",
            "maxLength": 10,
            "description": "The labels played most.",
            "items": { "type": "string", "maxLength": 1000, "maxGraphemes": 200 }
          },
          "artists": {
            "type": "array",
            "maxLength": 10,
            "description": "The artists played most.",
            "items": { "type": "string", "maxLength": 1000, "maxGraphemes": 200 }
          },
          "era": { "type": "ref", "ref": "#era" },
          "signature": {
            "type": "array",
            "maxLength": 50,
            "description": "Tracks played again and again, pinned ones first.",
            "items": { "type": "ref", "ref": "#track" }
          },
          "prep": { "type": "ref", "ref": "#prep" },
          "collection": { "type": "ref", "ref": "#collection" },
          "style": { "type": "ref", "ref": "#style" }
        }
      }
    },
    "count": {
      "type": "object",
      "description": "How many: count when exact, atLeast when rounded down to a round number. One of the two.",
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "atLeast": { "type": "integer", "minimum": 0 }
      }
    },
    "sets": {
      "type": "object",
      "description": "The sets the profile is built from: how many (count or atLeast, as in #count), since when, and how long.",
      "required": ["medianTracks"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "atLeast": { "type": "integer", "minimum": 0 },
        "since": { "type": "integer", "description": "The year of the oldest set." },
        "medianTracks": {
          "type": "integer",
          "minimum": 0,
          "description": "Tracks in a typical set."
        }
      }
    },
    "tempo": {
      "type": "object",
      "description": "BPM: the range the middle 80% of plays fall in, and the median.",
      "required": ["low", "high", "median"],
      "properties": {
        "low": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 },
        "median": { "type": "integer", "minimum": 0 }
      }
    },
    "arc": {
      "type": "object",
      "description": "Set shape: the percent of sets whose last quarter is at least 2 BPM faster than their first (builds), within 2 BPM of it (steady), or at least 2 BPM slower (windsDown).",
      "required": ["shape", "builds", "steady", "windsDown"],
      "properties": {
        "shape": {
          "type": "string",
          "description": "What half the sets or more do, or varies.",
          "knownValues": ["builds", "steady", "windsDown", "varies"]
        },
        "builds": { "type": "integer", "minimum": 0, "maximum": 100 },
        "steady": { "type": "integer", "minimum": 0, "maximum": 100 },
        "windsDown": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "mixing": {
      "type": "object",
      "description": "Transitions between consecutive tracks in sets, as percents.",
      "properties": {
        "harmonic": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Into a key that mixes on the Camelot wheel (same key, one step, relative, energy boost)."
        },
        "smoothTempo": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Changing tempo by 3% or less."
        },
        "genreChanges": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Into another genre."
        }
      }
    },
    "keys": {
      "type": "object",
      "required": ["top"],
      "properties": {
        "top": {
          "type": "array",
          "maxLength": 12,
          "description": "Camelot keys played most, most first (8A is A minor, 8B C major).",
          "items": { "type": "string", "maxLength": 3 }
        },
        "minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Percent of plays in minor keys."
        }
      }
    },
    "energy": {
      "type": "object",
      "description": "Percent of plays in each of rekordbox's phrase moods.",
      "required": ["high", "mid", "low"],
      "properties": {
        "high": { "type": "integer", "minimum": 0, "maximum": 100 },
        "mid": { "type": "integer", "minimum": 0, "maximum": 100 },
        "low": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "share": {
      "type": "object",
      "required": ["name", "share"],
      "properties": {
        "name": { "type": "string", "maxLength": 1000, "maxGraphemes": 200 },
        "share": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Percent of plays."
        }
      }
    },
    "era": {
      "type": "object",
      "properties": {
        "medianYear": {
          "type": "integer",
          "description": "Half the plays came out this year or earlier."
        },
        "recent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Percent of plays released that year or the year before."
        }
      }
    },
    "track": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "artist": { "type": "string", "maxLength": 3000, "maxGraphemes": 300 },
        "title": { "type": "string", "maxLength": 3000, "maxGraphemes": 300 }
      }
    },
    "prep": {
      "type": "object",
      "description": "Percent of the collection with hot cues, memory cues and loops set.",
      "required": ["hotCues", "memoryCues", "loops"],
      "properties": {
        "hotCues": { "type": "integer", "minimum": 0, "maximum": 100 },
        "memoryCues": { "type": "integer", "minimum": 0, "maximum": 100 },
        "loops": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "collection": {
      "type": "object",
      "required": ["tracks", "playlists"],
      "properties": {
        "tracks": { "type": "ref", "ref": "#count" },
        "playlists": { "type": "ref", "ref": "#count" }
      }
    },
    "style": {
      "type": "object",
      "description": "My Settings that say something about how the DJ plays. Values as in computer.localnetwork.locallibrary.settings.",
      "properties": {
        "quantize": { "type": "string", "knownValues": ["off", "on"] },
        "sync": { "type": "string", "knownValues": ["off", "on"] },
        "masterTempo": { "type": "string", "knownValues": ["off", "on"] },
        "jogMode": { "type": "string", "knownValues": ["cdj", "vinyl"] },
        "vinylSpeedAdjust": { "type": "string", "knownValues": ["touch-release", "touch", "release"] },
        "tempoRange": { "type": "string", "knownValues": ["6", "10", "16", "wide"] },
        "autoCue": { "type": "string", "knownValues": ["off", "on"] }
      }
    }
  }
}
