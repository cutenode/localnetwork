{
	"lexicon": 1,
	"id": "computer.localnetwork.people.invite",
	"defs": {
		"main": {
			"type": "record",
			"key": "any",
			"description": "An invite to join a performer's, party's or venue's space, keyed by the invitee's DID. Written by the Local Network root account for someone with people.manage. The invitee isn't a member until they accept, which replaces it with a computer.localnetwork.people.person record.",
			"record": {
				"type": "object",
				"required": ["subject", "role", "capabilities", "invitedBy", "createdAt"],
				"properties": {
					"subject": { "type": "string", "format": "did" },
					"role": { "type": "ref", "ref": "computer.localnetwork.people.defs#role" },
					"capabilities": { "type": "ref", "ref": "computer.localnetwork.people.defs#capabilities" },
					"invitedBy": { "type": "string", "format": "did" },
					"message": { "type": "string", "maxLength": 3000, "maxGraphemes": 300 },
					"createdAt": { "type": "string", "format": "datetime" },
					"expiresAt": { "type": "string", "format": "datetime" }
				}
			}
		}
	}
}
