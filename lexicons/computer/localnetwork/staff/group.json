{
	"lexicon": 1,
	"id": "computer.localnetwork.staff.group",
	"defs": {
		"main": {
			"type": "record",
			"key": "tid",
			"description": "A named group of accounts that feature flags can be turned on for. Written only by the root account into the staff space.",
			"record": {
				"type": "object",
				"required": ["name", "members", "createdAt", "updatedBy", "updatedAt"],
				"properties": {
					"name": { "type": "string", "maxLength": 640, "maxGraphemes": 64 },
					"description": { "type": "string", "maxLength": 3000, "maxGraphemes": 300 },
					"members": {
						"type": "array",
						"maxLength": 5000,
						"items": { "type": "string", "format": "did" }
					},
					"createdAt": { "type": "string", "format": "datetime" },
					"updatedBy": { "type": "string", "format": "did" },
					"updatedAt": { "type": "string", "format": "datetime" }
				}
			}
		}
	}
}
