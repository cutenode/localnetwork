{
	"lexicon": 1,
	"id": "computer.localnetwork.locallibraryPublishing",
	"defs": {
		"main": {
			"type": "permission-set",
			"title": "Publish from locallibrary",
			"detail": "Publish and update your DJ profile, your sets and your locallibrary settings, and ask Local Network's directory to read them again.",
			"permissions": [
				{
					"type": "permission",
					"resource": "repo",
					"collection": ["computer.localnetwork.locallibrary.settings"],
					"action": ["create", "update"]
				},
				{
					"type": "permission",
					"resource": "repo",
					"collection": ["computer.localnetwork.dj.profile"],
					"action": ["create", "update"]
				},
				{
					"type": "permission",
					"resource": "repo",
					"collection": ["computer.localnetwork.dj.set"],
					"action": ["create", "update"]
				},
				{
					"type": "permission",
					"resource": "rpc",
					"lxm": ["computer.localnetwork.directory.requestIndex"],
					"aud": "*"
				}
			]
		}
	}
}
