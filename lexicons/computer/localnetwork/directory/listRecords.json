{
	"lexicon": 1,
	"id": "computer.localnetwork.directory.listRecords",
	"defs": {
		"main": {
			"type": "query",
			"description": "List the records of one collection in one account's repo that the directory indexed, by record key, last first, like com.atproto.repo.listRecords.",
			"parameters": {
				"type": "params",
				"required": ["actor", "collection"],
				"properties": {
					"actor": { "type": "string", "format": "did" },
					"collection": { "type": "string", "format": "nsid" },
					"limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 },
					"cursor": { "type": "string", "maxLength": 512, "description": "The record key the last page ended on." }
				}
			},
			"output": {
				"encoding": "application/json",
				"schema": {
					"type": "object",
					"required": ["records"],
					"properties": {
						"records": {
							"type": "array",
							"items": { "type": "ref", "ref": "computer.localnetwork.directory.defs#recordView" }
						},
						"cursor": { "type": "string", "maxLength": 512 }
					}
				}
			}
		}
	}
}
