{
	"lexicon": 1,
	"id": "computer.localnetwork.directory.matchProjects",
	"defs": {
		"main": {
			"type": "query",
			"description": "Rank active projects by how well they fit a show, best first.",
			"parameters": {
				"type": "params",
				"properties": {
					"latE6": {
						"type": "integer",
						"minimum": -90000000,
						"maximum": 90000000,
						"description": "Latitude in millionths of a degree, like the record's location.latE6."
					},
					"lngE6": {
						"type": "integer",
						"minimum": -180000000,
						"maximum": 180000000,
						"description": "Longitude in millionths of a degree."
					},
					"radiusKm": { "type": "integer", "minimum": 1, "maximum": 2000, "default": 50 },
					"genres": { "type": "array", "maxLength": 12, "items": { "type": "string", "maxLength": 48 } },
					"budgetTier": { "type": "string", "knownValues": ["community", "emerging", "established", "headliner"] },
					"capacity": { "type": "integer", "minimum": 1 },
					"setType": { "type": "string", "maxLength": 32 },
					"formats": { "type": "array", "maxLength": 10, "items": { "type": "string", "maxLength": 48 } },
					"includeOutOfRange": { "type": "boolean", "default": false },
					"limit": { "type": "integer", "minimum": 1, "maximum": 50, "default": 30 }
				}
			},
			"output": {
				"encoding": "application/json",
				"schema": {
					"type": "object",
					"required": ["matches"],
					"properties": {
						"matches": {
							"type": "array",
							"items": { "type": "ref", "ref": "computer.localnetwork.directory.defs#match" }
						}
					}
				}
			}
		}
	}
}
