{
	"lexicon": 1,
	"id": "computer.localnetwork.directory.listSets",
	"defs": {
		"main": {
			"type": "query",
			"description": "List the sets some accounts published, most recently played first. Only accounts that manage a published project have their sets listed.",
			"parameters": {
				"type": "params",
				"required": ["actors"],
				"properties": {
					"actors": { "type": "array", "maxLength": 10, "items": { "type": "string", "format": "did" } },
					"limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 }
				}
			},
			"output": {
				"encoding": "application/json",
				"schema": {
					"type": "object",
					"required": ["sets"],
					"properties": {
						"sets": {
							"type": "array",
							"items": { "type": "ref", "ref": "computer.localnetwork.directory.defs#setView" }
						}
					}
				}
			}
		}
	}
}
