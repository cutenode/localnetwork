{
	"lexicon": 1,
	"id": "computer.localnetwork.directory.getProject",
	"defs": {
		"main": {
			"type": "query",
			"description": "Get one published project by URI or slug. The output has no project when none matches.",
			"parameters": {
				"type": "params",
				"properties": { "uri": { "type": "string", "format": "at-uri" }, "slug": { "type": "string", "maxLength": 64 } }
			},
			"output": {
				"encoding": "application/json",
				"schema": {
					"type": "object",
					"properties": { "project": { "type": "ref", "ref": "computer.localnetwork.directory.defs#projectView" } }
				}
			}
		}
	}
}
