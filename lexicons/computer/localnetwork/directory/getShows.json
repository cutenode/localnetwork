{
	"lexicon": 1,
	"id": "computer.localnetwork.directory.getShows",
	"defs": {
		"main": {
			"type": "query",
			"description": "Get shows by URI, past ones too, in the order asked for. Shows the directory doesn't list are left out.",
			"parameters": {
				"type": "params",
				"required": ["uris"],
				"properties": {
					"uris": { "type": "array", "maxLength": 25, "items": { "type": "string", "format": "at-uri" } }
				}
			},
			"output": {
				"encoding": "application/json",
				"schema": {
					"type": "object",
					"required": ["shows"],
					"properties": {
						"shows": {
							"type": "array",
							"items": { "type": "ref", "ref": "computer.localnetwork.directory.defs#showView" }
						}
					}
				}
			}
		}
	}
}
