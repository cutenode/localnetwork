{
	"name": "localnetwork-monorepo",
	"private": true,
	"scripts": {
		"dev": "pnpm --filter localnetwork dev",
		"build": "pnpm --filter localnetwork build",
		"check": "pnpm --filter localnetwork check",
		"lint": "pnpm --filter localnetwork lint",
		"format": "pnpm lexicons:format && pnpm --filter localnetwork format",
		"format:check": "pnpm lexicons:format --check && pnpm --filter localnetwork format:check",
		"lexicons:format": "oxfmt -c apps/web/.oxfmtrc.json lexicons/computer",
		"test": "pnpm --filter localnetwork test",
		"knip": "pnpm --filter localnetwork knip",
		"verify": "pnpm lexicons:format --check && pnpm --filter localnetwork verify"
	},
	"devDependencies": {
		"lefthook": "^2.1.16",
		"oxfmt": "^0.71.0"
	},
	"engines": {
		"node": ">=24.12"
	},
	"packageManager": "pnpm@12.6.0"
}
