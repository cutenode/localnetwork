{
	"name": "localnetwork-monorepo",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "pnpm -r --parallel dev",
		"build": "pnpm -r build",
		"check": "pnpm -r check",
		"lint": "pnpm -r lint",
		"format": "pnpm lexicons:format && pnpm -r format",
		"format:check": "pnpm lexicons:format --check && pnpm -r format:check",
		"lexicons:format": "oxfmt lexicons/computer",
		"test": "pnpm -r test",
		"knip": "pnpm -r knip",
		"verify": "pnpm lexicons:format --check && pnpm -r verify",
		"atstore": "pnpm -C packages/atstore assets",
		"test:tools": "vitest run --coverage"
	},
	"devDependencies": {
		"@ast-grep/cli": "^0.51.0",
		"@oxlint/plugins": "1.86.0",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@vitest/coverage-v8": "^5.0.5",
		"ajv": "^8.20.0",
		"jsdom": "^30.1.3",
		"lefthook": "^2.1.16",
		"mermaid": "12.3.0",
		"oxfmt": "^0.71.0",
		"oxlint": "1.86.0",
		"railway": "^3.16.0",
		"typescript": "^6.0.3",
		"vitest": "^5.0.5"
	},
	"engines": {
		"node": ">=24.12"
	},
	"packageManager": "pnpm@12.6.0"
}
