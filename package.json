{
	"name": "localnetwork-monorepo",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "pnpm -r --parallel dev",
		"build": "pnpm -r build",
		"check": "pnpm check:tools && pnpm -r check",
		"lint": "pnpm lint:tools && pnpm -r lint",
		"format": "pnpm lexicons:format && pnpm format:tools && pnpm -r format",
		"format:check": "pnpm lexicons:format --check && pnpm format:tools --check && pnpm -r format:check",
		"check:tools": "tsc",
		"lint:tools": "oxlint --type-aware tools .railway vitest.config.ts commitlint.config.js apps/locallibrary/bombadil",
		"format:tools": "oxfmt tools .railway vitest.config.ts commitlint.config.js flags benchmarks packages/tokens apps/locallibrary/bombadil '!**/*.md'",
		"lexicons:format": "oxfmt lexicons/computer",
		"test": "pnpm -r test",
		"knip": "knip && knip --production",
		"verify": "pnpm lexicons:format --check && pnpm format:tools --check && pnpm lint:tools && pnpm check:tools && pnpm knip && pnpm -r verify",
		"atstore": "pnpm --filter atstore assets",
		"test:tools": "vitest run --coverage"
	},
	"devDependencies": {
		"@ast-grep/cli": "^0.51.0",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@lavamoat/harden": "0.8.1",
		"@oxlint/plugins": "1.86.0",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/node": "^24.19.2",
		"@vitest/coverage-v8": "^5.0.5",
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"jsdom": "^30.1.3",
		"knip": "6.44.2",
		"lefthook": "^2.1.16",
		"mermaid": "12.3.0",
		"oxfmt": "^0.71.0",
		"oxlint": "1.86.0",
		"oxlint-tsgolint": "^7.0.2004",
		"railway": "^3.16.0",
		"typescript": "^6.0.3",
		"vitest": "^5.0.5",
		"yaml": "^2.9.1"
	},
	"engines": {
		"node": ">=24.12"
	},
	"packageManager": "pnpm@12.6.0"
}
