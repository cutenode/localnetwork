# The build context is the repo root, but only the web app's image is built from it
# (apps/web/Dockerfile). Send the workspace files, the lexicons and apps/web, minus what's local or generated.
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!lexicons
!apps/web
apps/web/node_modules
apps/web/.svelte-kit
apps/web/build
apps/web/data
apps/web/coverage
apps/web/test-results
apps/web/playwright-report
apps/web/blob-report
apps/web/.env
apps/web/.env.*
apps/web/.claude
