{
	"name": "localtoolbox",
	"version": "2.11.0",
	"private": true,
	"description": "SoundCloud tools for DJs as a Chrome extension: track lists, download links, artists, and a queue to batch them.",
	"type": "module",
	"scripts": {
		"dev": "vite build --mode development --watch",
		"build": "vite build",
		"zip": "vite build && cd dist && zip -qr ../localtoolbox.zip .",
		"check": "svelte-check --tsconfig ./tsconfig.json && svelte-check --tsconfig ./tsconfig.node.json",
		"lint": "oxlint --type-aware",
		"lint:fix": "oxlint --type-aware --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"knip": "knip",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:shuffle": "vitest run --sequence.shuffle.files --sequence.shuffle.tests",
		"test:repeat": "vitest run --repeats=1",
		"test:coverage": "vitest run --coverage",
		"test:mutation": "stryker run",
		"validate:state": "node scripts/validate-state.mts",
		"verify": "pnpm format:check && pnpm lint && pnpm check && pnpm knip && pnpm test:coverage && pnpm test:shuffle && pnpm test:repeat && pnpm build"
	},
	"dependencies": {
		"@lucide/svelte": "^1.43.0",
		"bits-ui": "^2.19.1",
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.0",
		"@stryker-mutator/core": "^10.0.0",
		"@stryker-mutator/vitest-runner": "^10.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/chrome": "^0.3.0",
		"@types/node": "^24.13.6",
		"@vitest/coverage-v8": "^5.0.0",
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"fast-check": "^4.9.0",
		"jsdom": "^30.0.1",
		"knip": "^6.39.0",
		"oxfmt": "^0.71.0",
		"oxlint": "1.86.0",
		"oxlint-tsgolint": "^7.0.2003",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"ts-blank-space": "^0.9.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.2.2",
		"vitest": "^5.0.0"
	},
	"engines": {
		"node": ">=24.12"
	}
}
