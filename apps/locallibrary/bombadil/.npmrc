# npm's supply-chain settings for Bombadil's own project (tools/policy.sh checks them with harden).
# Skip versions published in the last 3 days.
min-release-age=3
# No dependencies from git or remote tarball URLs, and no git at all for older npm versions.
allow-git=none
git=false
allow-remote=none
# Install scripts run only for packages package.json's allowScripts approves, at exact versions.
allow-scripts-pin=true
