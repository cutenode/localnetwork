{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Array_of_Model",
  "type": "array",
  "items": {
    "$ref": "#/$defs/Model"
  },
  "$defs": {
    "Audio": {
      "description": "One audio format a model plays, at these sample rates (Hz) and bit depths.",
      "type": "object",
      "properties": {
        "codec": {
          "$ref": "#/$defs/Codec"
        },
        "depths": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0
          }
        },
        "inferred": {
          "type": "boolean"
        },
        "rates": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        }
      },
      "required": [
        "codec",
        "rates",
        "depths",
        "inferred"
      ]
    },
    "Codec": {
      "description": "An audio format players list.",
      "type": "string",
      "enum": [
        "mp3",
        "aac",
        "wav",
        "aiff",
        "flac",
        "alac"
      ]
    },
    "Exfat": {
      "description": "Whether a model reads exFAT.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "no",
            "yes"
          ]
        },
        {
          "description": "With this firmware version or later.",
          "type": "object",
          "properties": {
            "firmware": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "firmware"
          ]
        }
      ]
    },
    "Kind": {
      "oneOf": [
        {
          "description": "A multi player (CDJ, XDJ-1000...).",
          "type": "string",
          "const": "player"
        },
        {
          "description": "Players and a mixer in one unit (XDJ-XZ, OPUS-QUAD...).",
          "type": "string",
          "const": "all_in_one"
        },
        {
          "description": "A mixer that reads USB drives for settings and firmware only.",
          "type": "string",
          "const": "mixer"
        }
      ]
    },
    "Model": {
      "type": "object",
      "properties": {
        "audio": {
          "description": "The formats it plays. A format missing from the list doesn't play.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Audio"
          }
        },
        "audio_inferred": {
          "description": "The list of formats is itself inferred: a format missing from it probably doesn't play.",
          "type": "boolean"
        },
        "exfat": {
          "$ref": "#/$defs/Spec_for_Exfat"
        },
        "export_pdb": {
          "description": "Reads Device Library (`export.pdb`).",
          "$ref": "#/$defs/Spec_for_boolean"
        },
        "kind": {
          "$ref": "#/$defs/Kind"
        },
        "name": {
          "description": "As AlphaTheta writes it: `CDJ-2000NXS2`, `OPUS-QUAD`.",
          "type": "string"
        },
        "notes": {
          "description": "What else is worth knowing about it.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "onelibrary": {
          "description": "Reads OneLibrary (`exportLibrary.db`, called Device Library Plus before October 2025).",
          "$ref": "#/$defs/Spec_for_boolean"
        },
        "source": {
          "description": "Where the values come from.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "kind",
        "export_pdb",
        "onelibrary",
        "exfat",
        "audio",
        "audio_inferred",
        "notes",
        "source"
      ]
    },
    "Spec_for_Exfat": {
      "description": "A value, and whether it's inferred rather than documented.",
      "type": "object",
      "properties": {
        "inferred": {
          "type": "boolean"
        },
        "value": {
          "$ref": "#/$defs/Exfat"
        }
      },
      "required": [
        "value",
        "inferred"
      ]
    },
    "Spec_for_boolean": {
      "description": "A value, and whether it's inferred rather than documented.",
      "type": "object",
      "properties": {
        "inferred": {
          "type": "boolean"
        },
        "value": {
          "type": "boolean"
        }
      },
      "required": [
        "value",
        "inferred"
      ]
    }
  }
}
