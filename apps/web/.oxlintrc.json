{
	"$schema": "../../node_modules/oxlint/configuration_schema.json",
	"extends": ["../../.oxlintrc.json"],
	"ignorePatterns": ["build/**", ".svelte-kit/**", "data/**", "playwright-report/**", "test-results/**"],
	"overrides": [
		{
			"files": ["scripts/**", "tests/**"],
			"rules": {
				"no-console": "off"
			}
		}
	]
}
