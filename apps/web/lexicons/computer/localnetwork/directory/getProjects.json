{
	"lexicon": 1,
	"id": "computer.localnetwork.directory.getProjects",
	"defs": {
		"main": {
			"type": "query",
			"description": "Get published projects by URI, in any status. Unknown URIs are left out.",
			"parameters": {
				"type": "params",
				"required": ["uris"],
				"properties": {
					"uris": { "type": "array", "maxLength": 25, "items": { "type": "string", "format": "at-uri" } }
				}
			},
			"output": {
				"encoding": "application/json",
				"schema": {
					"type": "object",
					"required": ["projects"],
					"properties": {
						"projects": {
							"type": "array",
							"items": { "type": "ref", "ref": "computer.localnetwork.directory.defs#projectView" }
						}
					}
				}
			}
		}
	}
}
