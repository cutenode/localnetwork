{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"entry": ["src/routes/**/+*.{ts,svelte}", "scripts/*.ts", "tests/**/*.ts", "src/**/*.test.ts"],
	"project": ["src/**/*.{ts,svelte}", "scripts/**/*.ts", "tests/**/*.ts"],
	"ignoreDependencies": ["@tailwindcss/forms", "@tailwindcss/typography", "@fontsource/vt323", "tailwindcss"],
	"ignoreExportsUsedInFile": true
}
