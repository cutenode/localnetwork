{
	"name": "localnetwork",
	"version": "0.0.1",
	"private": true,
	"description": "Find local DJs for your shows. Built on the AT Protocol and atproto spaces.",
	"license": "MIT",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "tsx scripts/dev-network.ts --app",
		"dev:network": "tsx scripts/dev-network.ts",
		"dev:app": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxlint --type-aware",
		"lint:fix": "oxlint --type-aware --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"knip": "knip",
		"test": "vitest run --project server --project client",
		"test:unit": "vitest --project server",
		"test:client": "vitest run --project client",
		"test:integration": "vitest run --project integration",
		"test:coverage": "vitest run --coverage --project=!build --tags-filter=!budget",
		"test:build": "vitest run --project build",
		"test:e2e": "playwright test",
		"test:lighthouse": "pnpm build && lhci autorun",
		"lexicons:publish": "tsx scripts/publish-lexicons.ts",
		"fixtures:mix": "tsx scripts/mix-fixture.ts",
		"verify": "pnpm format:check && pnpm lint && pnpm check && pnpm test && pnpm test:storybook && pnpm test:build",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"test:storybook": "vitest run --project storybook"
	},
	"dependencies": {
		"@atproto/api": "0.0.0-spaces-alpha-20261001173819",
		"@atproto/common-web": "0.0.0-spaces-alpha-20261001173819",
		"@atproto/crypto": "0.0.0-spaces-alpha-20261001173819",
		"@atproto/identity": "0.0.0-spaces-alpha-20261001173819",
		"@atproto/lex-cbor": "0.0.0-spaces-alpha-20261001173819",
		"@atproto/lex-data": "0.0.0-spaces-alpha-20261001173819",
		"@atproto/lex-json": "0.0.0-spaces-alpha-20261001173819",
		"@atproto/lex-resolver": "^0.3.2",
		"@atproto/lexicon": "0.0.0-spaces-alpha-20261001173819",
		"@atproto/oauth-client-node": "0.0.0-spaces-alpha-20261001173819",
		"@atproto/oauth-scopes": "0.0.0-spaces-alpha-20261001173819",
		"@atproto/space": "0.0.0-spaces-alpha-20261001173819",
		"@fontsource-variable/instrument-sans": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@lucide/svelte": "^1.51.0",
		"bowser": "^2.14.1",
		"image-size": "^2.0.4",
		"kysely": "^0.29.6",
		"p-queue": "^9.3.3",
		"pino": "^10.4.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@atproto/dev-env": "0.0.0-spaces-alpha-20261001173819",
		"@atproto/sync": "0.0.0-spaces-alpha-20261001173819",
		"@axe-core/playwright": "^4.13.0",
		"@lhci/cli": "^0.15.1",
		"@playwright/test": "^1.63.0",
		"@storybook/addon-a11y": "10.6.1",
		"@storybook/addon-docs": "10.6.1",
		"@storybook/addon-svelte-csf": "^5.1.5",
		"@storybook/addon-vitest": "10.6.1",
		"@storybook/sveltekit": "10.6.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24.19.1",
		"@types/ws": "^8.18.2",
		"@vitest/browser-playwright": "^5.0.3",
		"@vitest/coverage-v8": "^5.0.3",
		"cloudflare": "^7.3.0",
		"knip": "^6.39.0",
		"marked": "^18.1.0",
		"marked-gfm-heading-id": "^4.1.4",
		"oxfmt": "^0.71.0",
		"oxlint": "^1.86.0",
		"oxlint-tsgolint": "^7.0.2003",
		"pino-pretty": "^13.1.3",
		"playwright": "^1.63.0",
		"storybook": "10.6.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.3",
		"vitest-browser-svelte": "^3.1.0",
		"wasmoon": "^1.16.0",
		"ws": "^8.22.0"
	},
	"engines": {
		"node": ">=24.12"
	}
}
