# Local Network configuration. For local development, `pnpm dev`
# writes a working .env.local for you; this file documents every option.

# Public origin of the app (OAuth redirect URIs and the did:web are derived from it).
PUBLIC_URL=https://localnetwork.computer

# SQLite file for the local index, sessions, and the audit outbox.
DATABASE_PATH=/data/localnetwork.db

# The Local Network root account: owns published projects and the spaces.
# Use a dedicated account. The spaces alpha only mints delegation tokens for
# full-access sessions, so this must be the account password, not an app password.
ROOT_IDENTIFIER=localnetwork.computer
ROOT_PASSWORD=
# Optional: skip DID resolution for the root's PDS.
# ROOT_SERVICE=https://pds.example
# Optional, read only by `pnpm lexicons:publish`: a Cloudflare API token with
# Zone > DNS > Edit on the localnetwork.computer zone alone. With it, the script
# creates or fixes the `_lexicon` TXT records itself instead of listing them.
# CLOUDFLARE_API_TOKEN=

# Comma-separated DIDs that are always admins (manage everyone else in-app).
ADMIN_DIDS=did:plc:yourdid

# Optional: the host that serves locallibrary's site (its OAuth client document).
# LOCALLIBRARY_HOST=locallibrary.localnetwork.computer

# HappyView, the AppView that indexes published projects and answers directory
# search, matching, and lookups.
HAPPYVIEW_URL=https://happyview.localnetwork.computer
# Use its public URL: HappyView only answers the host its own PUBLIC_URL names.
# Optional: a HappyView API key with lexicons:read, lexicons:create,
# scripts:read, scripts:manage, backfill:create, and backfill:read. With it, the
# app uploads its Lua scripts and lexicons at boot and backfills the root
# account's projects. Without it, manage those yourself.
# HAPPYVIEW_API_KEY=hv_...

# Optional: Local Network's space on userinput.app (at://<did>/app.userinput.space/<rkey>).
# With it, signed-in people post bug reports there from their own account; without
# it, "Report a bug" opens GitHub's issue form for everyone.
# USERINPUT_SPACE=

# Optional: Local Network's clients at the services locallibrary plugins sign in to
# through /api/token-exchange/<service>, whose token endpoints want a client secret.
# src/lib/server/token-exchange/services.json lists the services and their variables.
# A service without both answers that Local Network isn't set up for it yet.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MIXCLOUD_CLIENT_ID=
# MIXCLOUD_CLIENT_SECRET=
# SOUNDCLOUD_CLIENT_ID=
# SOUNDCLOUD_CLIENT_SECRET=

# Email for people who turn it on for their inbox: resend | log | none. Defaults
# to log outside production (the email goes to the log, not out), and in
# production to resend when RESEND_API_KEY is set, otherwise none.
# EMAIL_PROVIDER=resend
# A Resend API key with sending access, for a domain verified in Resend.
# RESEND_API_KEY=re_...
# Optional: the sender, by default "Local Network <inbox@host of PUBLIC_URL>".
# EMAIL_FROM=Local Network <inbox@localnetwork.computer>

# Inbox items as Bluesky DMs from the root account, for people who turn them on:
# bluesky | log | none. Defaults to log outside production and none in it. Before
# setting bluesky, check that Bluesky's relay and AppView know the root account
# (its PDS is crawled) and that the root can call chat.bsky.convo.getConvoAvailability.
# DM_PROVIDER=bluesky
# CHAT_SERVICE_DID=did:web:api.bsky.chat

# Identity resolution.
PLC_URL=https://plc.directory
# HANDLE_RESOLVER_URL=  # dev only: a PDS used to resolve handles like alice.test

# Sync. Write notifications need PUBLIC_URL reachable from space hosts.
SYNC_POLL_INTERVAL_MS=60000
# SYNC_NOTIFY=true
# SERVICE_DID=did:web:localnetwork.computer

# City search for location fields: open-meteo | nominatim | none
GEOCODER=open-meteo

# Logging: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Optional: daily backups of the database to an S3-compatible bucket (in production, the Railway
# bucket .railway/railway.ts sets these from). With BACKUP_S3_BUCKET set, the app backs up once a
# UTC day and keeps the newest of each of the last BACKUP_KEEP_DAILY days and BACKUP_KEEP_WEEKLY
# weeks. `pnpm db:restore` restores one (README.md, Backups).
# BACKUP_S3_ENDPOINT=https://t3.storageapi.dev
# BACKUP_S3_REGION=auto
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_PATH_STYLE=false  # true for older Railway buckets and most local S3 stand-ins
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=8

# Optional tuning.
# AUDIT_MAX_ATTEMPTS=12
# SESSION_DAYS=30
# ALLOW_PRIVATE_NETWORK=false
