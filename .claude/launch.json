{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mix-report-preview",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "exec python3 -m http.server \"$PORT\" --bind 127.0.0.1 --directory \"${LOCALLIBRARY_STORE:-$HOME/Library/Application Support/locallibrary}/reports\""
      ],
      "port": 8765,
      "autoPort": true
    },
    {
      "name": "localnetwork",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-lc",
        "cd \"$HOME/GitHub/cutenode/localnetwork\" && eval \"$(fnm env --shell bash)\" && fnm use 24 >/dev/null && PORT=5180 pnpm dev"
      ],
      "port": 5180,
      "url": "http://127.0.0.1:5180",
      "autoPort": false
    }
  ]
}
